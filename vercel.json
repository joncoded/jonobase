{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 5,
      "memory": 128
    },
    "blog/**": {
      "maxDuration": 5,
      "memory": 128
    },
    "**": {
      "maxDuration": 5,
      "memory": 128
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
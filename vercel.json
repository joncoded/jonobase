  "functions": {
    "blog/**/**": {
        "maxDuration": 5,
        "memory": 128
    }, 
    "code/**/**": {
        "maxDuration": 5,
        "memory": 128
    },
    "text/**/**": {
        "maxDuration": 5,
        "memory": 128
    },
    "finds/**": {
